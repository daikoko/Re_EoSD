; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Re_EoSD"
run/main_scene="res://Master/Main/Master.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/image="res://Master/Main/Bootsplash.png"
config/icon="res://Master/Main/Icon256.png"
config/macos_native_icon="res://Master/Main/Icon256.png"
config/windows_native_icon="res://Master/Main/Icon.ico"

[autoload]

Debug="*res://Global/Debug.tscn"
GlobalSystem="*res://Global/GlobalSystem.gd"
GlobalSettings="*res://Global/GlobalSettings.gd"
GlobalStage="*res://Global/GlobalStage.gd"
GlobalPool="*res://Global/GlobalPool.gd"
GlobalShooter="*res://Global/GlobalShooter.gd"
GlobalPlayer="*res://Global/GlobalPlayer.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

